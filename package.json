{
  "name": "novgorod-1995",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Novgorod 1995 — TypeScript + Vite + Canvas 2D arcade brawler/platformer",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh": "VITE_BASE=/the-game/ npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:sprite-colors": "vite-node scripts/check-sprite-colors.ts",
    "check:font-glyphs": "node scripts/check-font-glyphs.mjs",
    "check:todo-owner": "node scripts/check-todo-owner.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "happy-dom": "^20.14.5",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
