{
  "name": "novgorod-1995",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Novgorod 1995 — TypeScript + Vite + Canvas 2D arcade brawler/platformer",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh": "VITE_BASE=/the-game/ npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:sprite-colors": "vite-node scripts/check-sprite-colors.ts"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vite-node": "^6.0.0"
  }
}
